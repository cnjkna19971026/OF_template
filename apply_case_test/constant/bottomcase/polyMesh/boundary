2
(
    bottomcase_to_air
    {
        type            mappedWall;
        inGroups        1(wall);
        nFaces          45586;
        startFace       154578;
        sampleMode      nearestPatchFace;
        sampleRegion    air;
        samplePatch     air_to_bottomcase;
    }
    bottomcase_to_thermalpad
    {
        type            mappedWall;
        inGroups        1(wall);
        nFaces          586;
        startFace       200164;
        sampleMode      nearestPatchFace;
        sampleRegion    thermalpad;
        samplePatch     thermalpad_to_bottomcase;
    }
)

