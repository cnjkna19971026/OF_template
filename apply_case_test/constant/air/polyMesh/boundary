FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/air/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

6
(
    defaultFaces
    {
        type            wall;
        nFaces          4440;
        startFace       380885;
    }
    air_to_case
    {
        type            mappedWall;
        inGroups        1(wall);
        nFaces          88010;
        startFace       385325;
