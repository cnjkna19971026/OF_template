FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/soc/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


3
(
    soc_to_board
    {
        type            mappedWall;
        inGroups        1 ( wall );
        nFaces          1276;
        startFace       8152;
        sampleMode      nearestPatchFace;
        sampleRegion    board;
        samplePatch     board_to_soc;
    }

    soc_to_thermalpad
    {
        type            mappedWall;
        inGroups        1 ( wall );
        nFaces          542;
        startFace       9428;
        sampleMode      nearestPatchFace;
        sampleRegion    thermalpad;
        samplePatch     thermalpad_to_soc;
    }

    soc_to_air
    {
        type            mappedWall;
        inGroups        1 ( wall );
        nFaces          1174;
        startFace       9970;
        sampleMode      nearestPatchFace;
        sampleRegion    air;
        samplePatch     air_to_soc;
    }

)


