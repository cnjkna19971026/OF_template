FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "80/thermalpad";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 101325;

boundaryField
{
    thermalpad_to_soc
    {
        type            zeroGradient;
    }
    thermalpad_to_bottom_case
    {
        type            zeroGradient;
    }
    thermalpad_to_air
    {
        type            zeroGradient;
    }
}


